# --- WhisperX transcription sidecar ---------------------------------------
# Reference for the variables app.py reads from the environment. In the normal
# (Docker) setup these are supplied by the compose service `environment:` block
# (override from your shell, e.g. `export WHISPERX_HF_TOKEN=...`). This file is
# only needed if you run the service directly without Docker.

WHISPERX_SERVICE_HOST=0.0.0.0
WHISPERX_SERVICE_PORT=8001

# Hardware: cpu | cuda  ("gpu" is accepted as an alias for cuda).
# NOTE: cuda requires a CUDA torch build in this venv (see README.md).
WHISPERX_DEVICE=cpu

# ASR model and (optional) compute type. Default compute: int8 (cpu) / float16 (cuda).
WHISPERX_MODEL=large-v3
# WHISPERX_COMPUTE_TYPE=int8

# Keep the model warm this long (seconds) after the last job, then unload to free
# GPU/RAM. Cold-start on the next job. This is the "lazy + warm + release" knob.
WHISPERX_IDLE_TTL_SECONDS=300

WHISPERX_BATCH_SIZE=8
WHISPERX_MIN_SPEAKERS=2
WHISPERX_MAX_SPEAKERS=4

# Gated pyannote diarisation model: accept its terms on Hugging Face, then set a
# read token here. Without it, transcription still works but everything collapses
# to a single speaker. (HF_TOKEN is also honoured.)
WHISPERX_HF_TOKEN=
